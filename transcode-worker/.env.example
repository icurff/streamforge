# Azure Service Bus Configuration (Workload Identity or Connection String)
AZURE_SERVICEBUS_NAMESPACE=sb-streamforge-dev
AZURE_SERVICEBUS_QUEUE=transcode-queue
AZURE_SERVICEBUS_CONNECTION_STRING=

# Azure Storage Account (DefaultAzureCredential or Connection String)
AZURE_STORAGE_ACCOUNT_NAME=ststreamforcedev
AZURE_STORAGE_CONTAINER_NAME=vod-container
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_PUBLIC_URL=https://ststreamforcedev.blob.core.windows.net/vod-container
AZURE_MEDIA_CDN_URL=https://media.icurff.site

# Azure Cosmos DB / MongoDB
AZURE_COSMOS_MONGODB_URI=mongodb://localhost:27017/voddb
MONGO_DATABASE=voddb

# Scratch directory
WORKER_SCRATCH_DIR=/tmp/streamforge-worker
